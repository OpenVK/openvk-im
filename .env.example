DB_USER=root
DB_PASS=root
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_SOCKET=/var/run/mysqld/mysqld.sock # If set, takes priority over DB_HOST and DB_PORT
DB_NAME=openvk_im

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_SOCKET=/var/run/redis/redis-server.sock # If set, takes priority over REDIS_HOST and REDIS_PORT
REDIS_PASS=
REDIS_DB=0

APP_PORT=8080
# DO NOT SET TO "development" IF THE SERVER IS EXPOSED SOMEHOW!
APP_ENV =production 

SECRET_KEY = "key" # 64 bytes or longer 
MODERATOR_TOKEN="" # Should be left empty in production. (Used to read any chats)